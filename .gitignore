test/*.exe
tags-releases-backup/

# =============================================================================
# WEBSITE (Astro Starlight)
# =============================================================================
website/node_modules/
website/dist/
website/.astro/.env.private

# =============================================================================
# LOCAL DEVELOPMENT ARTIFACTS (never commit these)
# =============================================================================

# Local build outputs and temporary binaries
*.exe
*.exe~
build/
dist/

# Local debug and scratch directories
debug/
debug-*/
tmp/
temp/
scratch/

# Local environment and config overrides
.env
.env.*
!.env.example
config.json
claude_desktop_config.json

# IDE / AI agent local state (extra safety)
# Ignore individual entries inside .claude/ rather than the whole directory,
# so we can selectively re-include specific project-owned subpaths below.
.claude/settings.json
.claude/settings.local.json
.claude/commands/
.claude/skills/github-profesional
.claude/skills/go-secure
.claude/skills/mcp-spec-reviewer
.claude/skills/scopweb-theme
.agents/
.cursor/
.aider/

# Allow this project-owned skill to be tracked
!.claude/skills/mcp-mssql-tools/

# OS generated
.DS_Store
Thumbs.db
